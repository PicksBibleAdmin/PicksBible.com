rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          "p.ejigabusiness@gmail.com"
        ];
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    /* signed-in member who is free, or a paid member whose plan has not expired */
    function memberOk() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (me().tier == 'free' || me().paidUntilTs > request.time);
    }

    /* ---- existing (unchanged) ---- */
    match /public/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /fixtures/{id} { allow read, write: if isAdmin(); }
    match /props/{id}    { allow read, write: if isAdmin(); }
    match /picks/{id}    { allow read, write: if isAdmin(); }

    /* ---- members ---- */
    match /users/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      /* a new member can only create their OWN record, always as a free member */
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.tier == 'free'
        && request.resource.data.keys().hasOnly(['email','name','tier','createdAt','source']);
      allow update: if isAdmin()
        /* a member can edit only their own name, country and WhatsApp number (never their plan) */
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','country','whatsapp'])
            && request.resource.data.get('name','').size() <= 80
            && request.resource.data.get('country','').size() <= 60
            && request.resource.data.get('whatsapp','').size() <= 25)
        /* unsubscribe link: anyone holding the member's private key can switch emails off, and nothing else */
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unsub','proof'])
            && resource.data.keys().hasAny(['unsubToken'])
            && request.resource.data.proof == resource.data.unsubToken);
      allow delete: if isAdmin();
    }

    /* ---- email capture: anyone can add an email, only the admin can read the list ---- */
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','firstName','lastName','whatsapp','interest','page','source','createdAt','plan'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 120
        && request.resource.data.email.matches('.+@.+[.].+');
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unsub','proof'])
            && resource.data.keys().hasAny(['unsubToken'])
            && request.resource.data.proof == resource.data.unsubToken);
    }

    /* ---- one-to-one notifications (e.g. plan ending soon) ---- */
    match /notes/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.to == request.auth.uid);
      allow write: if isAdmin();
    }

    /* ---- VIP picks and messages: members read only what their plan allows.
       (written so Firestore can prove it for a query like audience array-contains 'gold') ---- */
    match /vip_feed/{id} {
      allow read: if isAdmin() || (memberOk() && (
          (me().tier == 'gold' && 'gold' in resource.data.audience) ||
          (me().tier == 'free' && 'free' in resource.data.audience)));
      allow write: if isAdmin();
    }
    /* Bet Gifts: packages given to registered members as an incentive; members read only the ones the admin has switched on */
    match /gifts/{id} {
      allow read: if isAdmin() || (memberOk() && resource.data.active == true
          && (resource.data.audience == 'all' || request.auth.uid in resource.data.to));
      allow write: if isAdmin();
    }
    /* Daily Dice Roll: a member can read only their own roll record; only the server (service account) writes it */
    match /dice/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /dice_wins/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }
    /* every dice roll (written by the server); the admin watches it live */
    match /dice_log/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    /* one small record per member per day, written when they open the site logged in; the admin counts them */
    match /activity/{id} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.ymd + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','email','ymd','at','n']);
      allow delete: if false;
    }
    match /broadcasts/{id} {
      allow read: if isAdmin() || (memberOk() && (
          (me().tier == 'gold' && 'gold' in resource.data.audience) ||
          (me().tier == 'free' && 'free' in resource.data.audience)));
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
